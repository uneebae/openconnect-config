# ───────────────────────────────────────────────────────────────
# DEMO URL 3 — RAAST Instant Transfer
# POST http://localhost:3010/api/v1/payment/raast-transfer
# ───────────────────────────────────────────────────────────────

### [9] RAAST Transfer — Happy Path (P2P)
# Expected: responseCode=00, raastTransactionId, status=COMPLETED
POST {{baseUrl}}/api/v1/payment/raast-transfer
Content-Type: {{contentType}}

{
  "channelId": "MOBILE_APP",
  "requestId": "RT20260423020",
  "traceId": "TRACE20260423020",
  "transactionDateTime": "2026-04-23T10:20:00.000Z",
  "senderIban": "PK36SCBL0000001123456789",
  "receiverIban": "PK36HABB0000001987654321",
  "receiverAlias": "",
  "amount": "5000.00",
  "currency": "PKR",
  "purposeCode": "P2P",
  "narration": "Loan repayment",
  "rrn": "202604230020",
  "stan": "100020"
}

###

### [10] RAAST Transfer — By Alias (mobile number / CNIC)
# Expected: responseCode=00, receiver identified by alias
POST {{baseUrl}}/api/v1/payment/raast-transfer
Content-Type: {{contentType}}

{
  "channelId": "INTERNET_BANKING",
  "requestId": "RT20260423021",
  "traceId": "TRACE20260423021",
  "transactionDateTime": "2026-04-23T10:21:00.000Z",
  "senderIban": "PK36SCBL0000001123456789",
  "receiverIban": "",
  "receiverAlias": "03001234567",
  "amount": "1500.00",
  "currency": "PKR",
  "purposeCode": "SALA",
  "narration": "Monthly salary",
  "rrn": "202604230021",
  "stan": "100021"
}

###

### [11] RAAST Transfer — Amount Exceeds Limit
# Expected: responseCode=ER04, "Transaction amount exceeds RAAST per-transaction limit"
POST {{baseUrl}}/api/v1/payment/raast-transfer
Content-Type: {{contentType}}

{
  "channelId": "MOBILE_APP",
  "requestId": "RT20260423022",
  "traceId": "TRACE20260423022",
  "transactionDateTime": "2026-04-23T10:22:00.000Z",
  "senderIban": "PK36SCBL0000001123456789",
  "receiverIban": "PK36HABB0000001987654321",
  "receiverAlias": "",
  "amount": "9999999.00",
  "currency": "PKR",
  "purposeCode": "P2P",
  "rrn": "202604230022",
  "stan": "100022"
}

###

### [12] RAAST Transfer — Blocked Receiver
# Expected: responseCode=ER09, "Receiver account is blocked"
POST {{baseUrl}}/api/v1/payment/raast-transfer
Content-Type: {{contentType}}

{
  "channelId": "MOBILE_APP",
  "requestId": "RT20260423023",
  "traceId": "TRACE20260423023",
  "transactionDateTime": "2026-04-23T10:23:00.000Z",
  "senderIban": "PK36SCBL0000001123456789",
  "receiverIban": "PK00RAST0000000000000000",
  "receiverAlias": "",
  "amount": "1000.00",
  "currency": "PKR",
  "purposeCode": "P2P",
  "rrn": "202604230023",
  "stan": "100023"
}

