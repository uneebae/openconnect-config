# ───────────────────────────────────────────────────────────────
# DEMO URL 4 — Card Verification / 3DS
# POST http://localhost:3010/api/v1/card/verify
# ───────────────────────────────────────────────────────────────

### [13] Card Verify — Happy Path (no 3DS)
# Expected: responseCode=CV00, VISA card verified
POST {{baseUrl}}/api/v1/card/verify
Content-Type: {{contentType}}

{
  "channelId": "E_COMMERCE",
  "requestId": "CV20260423030",
  "traceId": "TRACE20260423030",
  "transactionDateTime": "2026-04-23T10:30:00.000Z",
  "cardNumber": "4111111111111234",
  "expiryMonth": "12",
  "expiryYear": "28",
  "cvv": "123",
  "merchantId": "MCH_DEMO_001",
  "amount": "2500.00",
  "rrn": "202604230030",
  "stan": "100030"
}

###

### [14] Card Verify — With 3DS OTP (correct OTP)
# Expected: responseCode=CV00, threeDSAuthenticated=true
POST {{baseUrl}}/api/v1/card/verify
Content-Type: {{contentType}}

{
  "channelId": "E_COMMERCE",
  "requestId": "CV20260423031",
  "traceId": "TRACE20260423031",
  "transactionDateTime": "2026-04-23T10:31:00.000Z",
  "cardNumber": "5500000000001234",
  "expiryMonth": "06",
  "expiryYear": "27",
  "cvv": "456",
  "otp": "123456",
  "merchantId": "MCH_DEMO_001",
  "amount": "10000.00",
  "rrn": "202604230031",
  "stan": "100031"
}

###

